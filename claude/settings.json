{
  "effortLevel": "medium",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "jq -r '.tool_name' | xargs -I {} osascript -e 'display notification \"Waiting for your approval\" with title \"Permission needed: {}\"' 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/polireddi.manideep/.git-ai/bin/git-ai checkpoint claude --hook-input stdin",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/polireddi.manideep/.git-ai/bin/git-ai checkpoint claude --hook-input stdin",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "command": "jq -r '.task.subject // .task_id // \"Task\"' | xargs -I {} osascript -e 'display notification \"Task done\" with title \"{}\"' 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "sonnet",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read"
    ]
  },
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "command": "bash ~/.claude/statusline.sh",
    "type": "command"
  }
}