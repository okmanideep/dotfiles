{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "small_model": "openai/gpt-5.4-mini",
  "mcp": {
    "servers": {
      "launchdarkly": {
        "type": "remote",
        "url": "https://mcp.launchdarkly.com/mcp/launchdarkly",
        "disabled": true
      },
      "coralogix_nonprod": {
        "type": "remote",
        "url": "https://origin-bifrost-llm-proxy.cmd.hotstar-prod.com/mcp",
        "oauth": false,
        "disabled": true,
        "headers": {
          "x-bf-vk": "REPLACE_LOCALLY_CORALOGIX_NONPROD_BF_VK"
        }
      },
      "coralogix_prod": {
        "type": "remote",
        "url": "https://bifrost-llm-proxy-alb-0.cmd.hotstar-prod.com/mcp",
        "oauth": false,
        "disabled": true,
        "headers": {
          "x-bf-vk": "REPLACE_LOCALLY_CORALOGIX_PROD_BF_VK"
        }
      },
      "hotstar_eks": {
        "type": "remote",
        "url": "https://origin-bifrost-llm-proxy.cmd.hotstar-prod.com/mcp",
        "oauth": false,
        "disabled": true,
        "headers": {
          "x-bf-vk": "REPLACE_LOCALLY_HOTSTAR_EKS_BF_VK"
        }
      },
      "service_catalog": {
        "type": "remote",
        "url": "https://origin-bifrost-llm-proxy.cmd.hotstar-prod.com/mcp",
        "oauth": false,
        "disabled": true,
        "headers": {
          "x-bf-vk": "REPLACE_LOCALLY_SERVICE_CATALOG_BF_VK"
        }
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ],
        "disabled": true
      }
    }
  }
}
